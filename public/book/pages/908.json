{"number":908,"file":8,"localPage":100,"markers":[],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"Specify","id":0,"b":false,"i":true,"s":false},{"t":" if:","id":1,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,74.07,129.97,86.09],"firstLineX":78.0,"indent":6,"small":false},{"id":"b1","kind":"paragraph","spans":[{"t":"Acute:","id":2,"b":true,"i":false,"s":false},{"t":" Lasting a few hours or days.","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"Persistent:","id":4,"b":true,"i":false,"s":false},{"t":" Lasting weeks or months.","id":5,"b":false,"i":false,"s":false}],"level":4,"bbox":[97.2,90.89,298.43,120.89],"firstLineX":97.2,"indent":25,"small":false},{"id":"b2","kind":"paragraph","spans":[{"t":"Specify","id":6,"b":false,"i":true,"s":false},{"t":" if:","id":7,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,126.87,129.97,138.89],"firstLineX":78.0,"indent":6,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"Hyperactive:","id":8,"b":true,"i":false,"s":false},{"t":" The individual has a hyperactive level of psychomotor activity that","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"may be accompanied by mood lability, agitation, and/or refusal to cooperate with","id":10,"b":false,"i":false,"s":false},{"t":" "},{"t":"medical care.","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"Hypoactive:","id":12,"b":true,"i":false,"s":false},{"t":" The individual has a hypoactive level of psychomotor activity that","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"may be accompanied by sluggishness and lethargy that approaches stupor.","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"Mixed level of activity:","id":15,"b":true,"i":false,"s":false},{"t":" The individual has a normal level of psychomotor","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"activity even though attention and awareness are disturbed. Also includes","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"individuals whose activity level rapidly fluctuates.","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"Specify","id":19,"b":false,"i":true,"s":false},{"t":" whether:","id":20,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,143.69,526.71,281.69],"firstLineX":97.2,"indent":6,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"Substance intoxication delirium:","id":21,"b":true,"i":false,"s":false},{"t":" This diagnosis should be made instead of","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance intoxication when the symptoms in Criteria A and C predominate in","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"the clinical picture and when they are sufficiently severe to warrant clinical","id":24,"b":false,"i":false,"s":false},{"t":" "},{"t":"attention.","id":25,"b":false,"i":false,"s":false}],"level":4,"bbox":[97.2,286.49,526.78,341.69],"firstLineX":97.2,"indent":25,"small":false},{"id":"b5","kind":"paragraph","spans":[{"t":"Coding note:","id":26,"b":true,"i":false,"s":false},{"t":" The ICD-10-CM codes for the [specific substance] intoxication","id":27,"b":false,"i":false,"s":false},{"t":" "},{"t":"delirium are indicated in the table below. Note that the ICD-10-CM code","id":28,"b":false,"i":false,"s":false},{"t":" "},{"t":"depends on whether or not there is a comorbid substance use disorder","id":29,"b":false,"i":false,"s":false},{"t":" "},{"t":"present for the same class of substance. If a mild substance use disorder is","id":30,"b":false,"i":false,"s":false},{"t":" "},{"t":"comorbid with the substance intoxication delirium, the 4th position character is","id":31,"b":false,"i":false,"s":false},{"t":" "},{"t":"“1,” and the clinician should record “mild [substance] use disorder” before the","id":32,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance intoxication delirium (e.g., “mild cocaine use disorder with cocaine","id":33,"b":false,"i":false,"s":false},{"t":" "},{"t":"intoxication delirium”). If a moderate or severe substance use disorder is","id":34,"b":false,"i":false,"s":false},{"t":" "},{"t":"comorbid with the substance intoxication delirium, the 4th position character is","id":35,"b":false,"i":false,"s":false},{"t":" "},{"t":"“2,” and the clinician should record “moderate [substance] use disorder” or","id":36,"b":false,"i":false,"s":false},{"t":" "},{"t":"“severe [substance] use disorder,” depending on the severity of the comorbid","id":37,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance use disorder. If there is no comorbid substance use disorder (e.g.,","id":38,"b":false,"i":false,"s":false},{"t":" "},{"t":"after a one-time heavy use of the substance), then the 4th position character is","id":39,"b":false,"i":false,"s":false},{"t":" "},{"t":"“9,” and the clinician should record only the substance intoxication delirium.","id":40,"b":false,"i":false,"s":false}],"level":4,"bbox":[109.2,347.69,526.7,546.89],"firstLineX":109.2,"indent":37,"small":false},{"id":"b6","kind":"paragraph","spans":[{"t":"673","id":41,"b":false,"i":false,"s":false}],"level":4,"bbox":[306.0,562.65,324.0,574.65],"firstLineX":306.0,"indent":60,"small":false},{"id":"b7","kind":"paragraph","spans":[{"t":"ICD-10-CM","id":42,"b":true,"i":false,"s":false}],"level":4,"bbox":[372.88,593.69,433.51,605.69],"firstLineX":372.88,"indent":60,"small":false},{"id":"b11","kind":"paragraph","spans":[{"t":"With moderate or","id":46,"b":true,"i":false,"s":false}],"level":4,"bbox":[364.74,618.51,438.66,627.51],"firstLineX":364.74,"indent":60,"small":true},{"id":"b9","kind":"paragraph","spans":[{"t":"With mild use","id":44,"b":true,"i":false,"s":false},{"t":" "},{"t":"severe use","id":47,"b":true,"i":false,"s":false},{"t":" "},{"t":"Without use","id":49,"b":true,"i":false,"s":false}],"level":4,"bbox":[287.29,629.32,512.62,638.32],"firstLineX":287.29,"indent":60,"small":true},{"id":"b10","kind":"paragraph","spans":[{"t":"disorder","id":45,"b":true,"i":false,"s":false},{"t":" "},{"t":"disorder","id":48,"b":true,"i":false,"s":false},{"t":" "},{"t":"disorder",