{"number":706,"file":6,"localPage":100,"markers":["506"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"Note:","id":0,"b":true,"i":false,"s":false},{"t":" This diagnosis should be made instead of a diagnosis of substance","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"intoxication or substance withdrawal only when the symptoms in Criterion A","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"predominate in the clinical picture and are sufficiently severe to warrant clinical","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"attention.","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"Coding note:","id":5,"b":true,"i":false,"s":false},{"t":" The ICD-10-CM codes for the [specific substance/medication]-induced","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"sexual dysfunctions are indicated in the table below. Note that the ICD-10-CM code","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"depends on whether or not there is a comorbid substance use disorder present for","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"the same class of substance. In any case, an additional separate diagnosis of a","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance use disorder is not given. If a mild substance use disorder is comorbid","id":10,"b":false,"i":false,"s":false},{"t":" "},{"t":"with the substance-induced sexual dysfunction, the 4th position character is “1,” and","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"the clinician should record “mild [substance] use disorder” before the substance-","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"induced sexual dysfunction (e.g., “mild cocaine use disorder with cocaine-induced","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"sexual dysfunction”). If a moderate or severe substance use disorder is comorbid","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"with the substance-induced sexual dysfunction, the 4th position character is “2,” and","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"the clinician should record “moderate [substance] use disorder” or “severe","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"[substance] use disorder,” depending on the severity of the comorbid substance use","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder. If there is no comorbid substance use disorder (e.g., after a one-time heavy","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"use of the substance), then the 4th position character is “9,” and the clinician should","id":19,"b":false,"i":false,"s":false},{"t":" "},{"t":"record only the substance-induced sexual dysfunction.","id":20,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,74.09,528.0,347.69],"firstLineX":78.0,"indent":6,"small":false},{"id":"b1","kind":"paragraph","spans":[{"t":"ICD-10-CM","id":21,"b":true,"i":false,"s":false}],"level":4,"bbox":[365.68,366.89,426.31,378.89],"firstLineX":365.68,"indent":60,"small":false},{"id":"b2","kind":"paragraph","spans":[{"t":"With mild use","id":22,"b":true,"i":false,"s":false},{"t":" "},{"t":"With moderate or","id":24,"b":true,"i":false,"s":false},{"t":" "},{"t":"severe use disorder","id":25,"b":true,"i":false,"s":false}],"level":4,"bbox":[275.29,391.71,436.96,411.51],"firstLineX":275.29,"indent":60,"small":true},{"id":"b5","kind":"paragraph","spans":[{"t":"Without use","id":26,"b":true,"i":false,"s":false}],"level":4,"bbox":[458.78,391.71,510.22,400.71],"firstLineX":458.78,"indent":60,"small":true},{"id":"b3","kind":"paragraph","spans":[{"t":"disorder","id":23,"b":true,"i":false,"s":false},{"t":" "},{"t":"disorder","id":27,"b":true,"i":false,"s":false}],"level":4,"bbox":[286.52,402.51,502.48,411.51],"firstLineX":286.52,"indent":60,"small":true},{"id":"b7","kind":"paragraph","spans":[{"t":"Alcohol","id":28,"b":false,"i":false,"s":false},{"t":" "},{"t":"F10.181","id":29,"b":false,"i":false,"s":false},{"t":" "},{"t":"F10.281","id":30,"b":false,"i":false,"s":false},{"t":" "},{"t":"F10.981","i