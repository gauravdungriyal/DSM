ote:","id":21,"b":true,"i":false,"s":false},{"t":" Use additional code to identify the associated genetic or other","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"medical condition, neurodevelopmental disorder, or environmental factor.","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"Specify","id":24,"b":false,"i":true,"s":false},{"t":" current severity:","id":25,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,219.29,526.8,263.69],"firstLineX":109.2,"indent":6,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"Mild:","id":26,"b":true,"i":false,"s":false},{"t":" Symptoms are easily suppressed by sensory stimulus or distraction.","id":27,"b":false,"i":false,"s":false},{"t":" "},{"t":"Moderate:","id":28,"b":true,"i":false,"s":false},{"t":" Symptoms require explicit protective measures and behavioral","id":29,"b":false,"i":false,"s":false},{"t":" "},{"t":"modification.","id":30,"b":false,"i":false,"s":false},{"t":" "},{"t":"Severe:","id":31,"b":true,"i":false,"s":false},{"t":" Continuous monitoring and protective measures are required to prevent","id":32,"b":false,"i":false,"s":false},{"t":" "},{"t":"serious injury.","id":33,"b":false,"i":false,"s":false}],"level":4,"bbox":[97.2,268.49,526.72,345.29],"firstLineX":97.2,"indent":25,"small":false},{"id":"b5","kind":"heading","spans":[{"t":"Recording Procedures","id":34,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,368.49,219.91,382.29],"firstLineX":72.0,"indent":0,"small":false},{"id":"b6","kind":"paragraph","spans":[{"t":"For stereotypic movement disorder that is associated with a known genetic or other medical","id":35,"b":false,"i":false,"s":false},{"t":" "},{"t":"condition, neurodevelopmental disorder, or environmental factor, record stereotypic movement","id":36,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder associated with (name of condition, disorder, or factor) (e.g., stereotypic movement","id":37,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder associated with Lesch-Nyhan syndrome).","id":38,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,388.65,539.64,443.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b7","kind":"heading","spans":[{"t":"Specifiers","id":39,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,455.49,137.91,469.29],"firstLineX":72.0,"indent":0,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"The severity of non-self-injurious stereotypic movements ranges from mild presentations that are","id":40,"b":false,"i":false,"s":false},{"t":" "},{"t":"easily suppressed by a sensory stimulus or distraction to continuous movements that markedly","id":41,"b":false,"i":false,"s":false},{"t":" "},{"t":"interfere with all activities of daily living. Self-injurious behaviors range in severity along","id":42,"b":false,"i":false,"s":false},{"t":" "},{"t":"various dimensions, including the frequency, impact on adaptive functioning, and severity of","id":43,"b":false,"i":false,"s":false},{"t":" "},{"t":"bodily injury (from mild bruising or erythema from hitting hand against body, to lacerations or","id":44,"b":false,"i":false,"s":false},{"t":" "},{"t":"amputation of digits, to retinal detachment from head banging).","id":45,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,475.65,539.95,559.65],"firstLineX":72.0,"indent":0,"small":false},{"id":"b9","kind":"heading","spans":[{"t":"Diagnostic Features","id":46,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,571.29,203.82,585.09],"firstLineX":72.0,"indent":0,"small":false},{"id":"b10","kind":"paragraph","spans":[{"t":"The essential feature of stereotypic movement disorder is repetitive, seemingly driven, and","id":47,"b":false,"i":false,"s":false},{"t":" "},{"t":"apparently purposeless motor behavior (Criterion A). These behaviors are often rhythmical","id":48,"b":false,"i":false,"s":false},{"t":" "},{"t":"movements of the head, hands, or body without obvious adaptive function. The movements may","id":49,"b":false,"i":false,"s":false},{"t":" "},{"t":"or may not respond to efforts to stop them. Among typically developing children, the repetitive","id":50,"b":false,"i":false,"s":false},{"t":" "},{"t":"movements can usually be stopped when attention is directed to them","id":51,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,591.45,539.9,661.05],"firstLineX":72.0,"indent":0,"small":false},{"id":"b11","kind":"marker","spans":[{"t":"90","id":52,"b":false,"i":false,"s":false}],"level":4,"bbox":[300.0,675.45,312.0,687.45],"firstLineX":300.0,"indent":60,"small":false},{"id":"b12","kind":"paragraph","spans":[{"t":"or when the child is distracted from performing them. Among children with neurodevelopmental","id":53,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,701.85,539.64,713.85],"firstLineX":72.0,"indent":0,"small":false}],"figures":[],"ocr":null,"nativeTextSha256":"b33434d1f491b6cc89923edda592a7a21cb05264e36dce7807332d9f9c89f5cb","nativeCharacters":2289,"sparse":false,"tableCount":0}