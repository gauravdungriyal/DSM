rstLineX":364.2,"indent":60,"small":true},{"id":"b13","kind":"paragraph","spans":[{"t":"Note.","id":37,"b":false,"i":true,"s":false},{"t":" NIDA = National Institute on Drug Abuse.","id":38,"b":false,"i":false,"s":false},{"t":" "},{"t":"a","id":39,"b":false,"i":false,"s":false},{"t":"Available at ","id":40,"b":false,"i":false,"s":false},{"t":"www.psychiatry.org/dsm5","id":41,"b":false,"i":false,"s":false},{"t":".","id":42,"b":false,"i":false,"s":false}],"level":4,"bbox":[76.8,245.14,258.34,266.44],"firstLineX":76.8,"indent":5,"small":true},{"id":"b14","kind":"paragraph","spans":[{"t":"The measure was found to be clinically useful and to have good reliability in the DSM-5","id":43,"b":false,"i":false,"s":false},{"t":" "},{"t":"Field Trials that were conducted in adult clinical samples across the United States and in Canada.","id":44,"b":false,"i":false,"s":false},{"t":" "},{"t":"In the DSM-5 Field Trials, in which the individual’s symptom ratings were shared with the","id":45,"b":false,"i":false,"s":false},{"t":" "},{"t":"clinician before meeting, individuals reported that the results from the measure helped facilitate","id":46,"b":false,"i":false,"s":false},{"t":" "},{"t":"communication during the clinical encounter. Similarly, clinicians in both major academic-","id":47,"b":false,"i":false,"s":false},{"t":" "},{"t":"medical research institutions as well as routine clinical practice settings found the measures","id":48,"b":false,"i":false,"s":false},{"t":" "},{"t":"clinically useful and feasible for integration into everyday clinical care as well as specialty","id":49,"b":false,"i":false,"s":false},{"t":" "},{"t":"clinical settings. In addition to results from the DSM-5 Field Trials, several studies have","id":50,"b":false,"i":false,"s":false},{"t":" "},{"t":"evaluated the psychometric properties of the adult self-rated version of the cross-cutting","id":51,"b":false,"i":false,"s":false},{"t":" "},{"t":"symptom measure in a variety of populations. For example, findings from a large study of non-","id":52,"b":false,"i":false,"s":false},{"t":" "},{"t":"treatment-seeking college students across the United States demonstrated acceptable internal","id":53,"b":false,"i":false,"s":false},{"t":" "},{"t":"consistency and internal validity.","id":54,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,282.45,539.94,452.85],"firstLineX":90.0,"indent":0,"small":false},{"id":"b15","kind":"paragraph","spans":[{"t":"The parent/guardian-rated version of the measure (for children ages 6–17) consists of 25","id":55,"b":false,"i":false,"s":false},{"t":" "},{"t":"questions that assess 12 psychiatric domains, including depression, anger, irritability, mania,","id":56,"b":false,"i":false,"s":false},{"t":" "},{"t":"anxiety, somatic symptoms, inattention, suicidal ideation/attempt, psychosis, sleep disturbance,","id":57,"b":false,"i":false,"s":false},{"t":" "},{"t":"repetitive thoughts and behaviors, and substance use (","id":58,"b":false,"i":false,"s":false},{"t":"Table 2","id":59,"b":false,"i":false,"s":false},{"t":"). Each item asks the parent or","id":60,"b":false,"i":false,"s":false},{"t":" "},{"t":"guardian to rate how much (or how often) his or her child has been bothered by the specific","id":61,"b":false,"i":false,"s":false},{"t":" "},{"t":"psychiatric symptom during the past 2 weeks. The measure was also found to be clinically useful","id":62,"b":false,"i":false,"s":false},{"t":" "},{"t":"and to have good reliability in the DSM-5 Field Trials that were conducted in pediatric clinical","id":63,"b":false,"i":false,"s":false},{"t":" "},{"t":"samples across the United States. For children ages 11–17, along with the parent/guardian rating","id":64,"b":false,"i":false,"s":false},{"t":" "},{"t":"of the child’s symptoms, the clinician may consider having the child complete the child-rated","id":65,"b":false,"i":false,"s":false},{"t":" "},{"t":"version of the measure. The child-rated version of the measure can be found online at","id":66,"b":false,"i":false,"s":false},{"t":" "},{"t":"www.psychiatry.org/dsm5","id":67,"b":false,"i":false,"s":false},{"t":".","id":68,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,455.25,539.97,611.25],"firstLineX":90.0,"indent":0,"small":false},{"id":"b16","kind":"marker","spans":[{"t":"845","id":69,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,625.65,315.0,637.65],"firstLineX":297.0,"indent":60,"small":false},{"id":"b17","kind":"paragraph","spans":[{"t":"TABLE 2","id":70,"b":true,"i":false,"s":false},{"t":" Parent/guardian-rated DSM-5 Level 1 Cross-Cutting Symptom Measure","id":71,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,656.09,533.66,668.09],"firstLineX":72.0,"indent":0,"small":false},{"id":"b18","kind":"paragraph","spans":[{"t":"for child age 6–17: 12 domains, thresholds for further inquiry, and","id":72,"b":true,"i":false,"s":false},{"t":" "},{"t":"associated Level 2 measures","id":73,"b":true,"i":false,"s":false}],"level":4,"bbox":[134.4,670.49,509.39,696.89],"firstLineX":134.4,"indent":60,"small":false},{"id":"b19","kind":"paragraph","spans":[{"t":"Threshold to guide","id":74,"b":true,"i":false,"s":false},{"t":" "},{"t":"DSM-5 Level 2 Cross-Cutting Symptom","id":75,"b":true,"i":false,"s":false}],"level":4,"bbox":[243.6,707.61,526.82,716.61],"firstLineX":243.6,"indent":60,"small":true}],"figures":[],"ocr":null,"nativeTextSha256":"98e7aabd06156f3b308f5eabf05d9e8e0297ab1d795ca6cc7b755a3c30a354d9","nativeCharacters":2921,"sparse":false,"tableCount":0}