{"number":1093,"file":10,"localPage":83,"markers":["828"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"Z69.12","id":0,"b":true,"i":false,"s":false},{"t":" "},{"t":"Encounter for mental health services for perpetrator of spouse or partner","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"psychological abuse","id":2,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,76.49,471.87,103.05],"firstLineX":72.0,"indent":0,"small":false},{"id":"b1","kind":"paragraph","spans":[{"t":"Adult Abuse by Nonspouse or Nonpartner","id":3,"b":true,"i":false,"s":false},{"t":" "},{"t":"This category may be used when the abuse of an adult by another adult who is not an intimate","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"partner is a focus of clinical attention. Such maltreatment may involve acts of physical, sexual, or","id":5,"b":false,"i":false,"s":false},{"t":" "},{"t":"emotional abuse. Examples of adult abuse include nonaccidental acts of physical force (e.g.,","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"pushing/shoving, scratching, slapping, throwing something that could hurt, punching, biting) that","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"have resulted—or have reasonable potential to result—in physical harm or have caused","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"significant fear; forced or coerced sexual acts; and verbal or symbolic acts with the potential to","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"cause psychological harm (e.g., berating or humiliating the person; interrogating the person;","id":10,"b":false,"i":false,"s":false},{"t":" "},{"t":"restricting the person’s ability to come and go freely; obstructing the person’s access to","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"assistance; threatening the person; harming or threatening to harm people or things that the","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"person cares about; restricting the person’s","id":13,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,119.69,539.93,275.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b2","kind":"marker","spans":[{"t":"828","id":14,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,290.25,315.0,302.25],"firstLineX":297.0,"indent":60,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"access to or use of economic resources; isolating the person from family, friends, or social","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"support resources; stalking the person; trying to make the person think that he or she is crazy).","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"Acts for the purpose of physically protecting oneself or the other person are excluded.","id":17,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,316.65,539.86,357.45],"firstLineX":72.0,"indent":0,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"Adult Physical Abuse by Nonspouse or Nonpartner, Confirmed","id":18,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,371.9,395.85,383.9],"firstLineX":72.0,"indent":0,"small":false},{"id":"b5","kind":"paragraph","spans":[{"t":"T74.11XA","id":19,"b":true,"i":false,"s":false},{"t":" ","id":20,"b":false,"i":false,"s":false},{"t":"Initial encounter","id":21,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,389.69,210.93,401.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b6","kind":"paragraph","spans":[{"t":"T74.11XD","id":22,"b":true,"i":false,"s":false},{"t":" ","id":23,"b":false,"i":false,"s":false},{"t":"Subsequent encounter","id":24,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,410.09,237.61,422.25],"firstLineX":72.0,"indent":0,"small":false},{"id":"b7","kind":"paragraph","spans":[{"t":"Adult Physical Abuse by Nonspouse or Nonpartner, Suspected","id":25,"b":true,"i":false,"s":false},{"t":" "},{"t":"T76.11XA","id":26,"b":true,"i":false,"s":false},{"t":" ","id":27,"b":false,"i":false,"s":false},{"t":"Initial encounter","id":28,"b":false,"i":false,"s":false}],"le