{"number":1118,"file":11,"localPage":7,"markers":["852"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"such as the degree of cognitive and/or neurobiological deficits. Dimensional assessments capture","id":0,"b":false,"i":false,"s":false},{"t":" "},{"t":"meaningful variation in the severity of symptoms, which may help with treatment planning,","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"prognostic decision-making, and research on pathophysiological mechanisms. The Clinician-","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"Rated Dimensions of Psychosis Symptom Severity measure provides scales for the dimensional","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"assessment of the primary symptoms of psychosis, including hallucinations, delusions,","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorganized speech, abnormal psychomotor behavior, and negative symptoms. A scale for the","id":5,"b":false,"i":false,"s":false},{"t":" "},{"t":"dimensional assessment of cognitive impairment is also included. Many individuals with","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"psychotic disorders have impairments in a range of cognitive domains, which predict functional","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"abilities and prognosis. In addition, scales for dimensional assessment of depression and mania","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"are provided, which may alert clinicians to co-occurring mood pathology. The severity of mood","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"symptoms in psychosis has prognostic value and can guide treatment.","id":10,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,74.05,539.93,230.25],"firstLineX":72.0,"indent":0,"small":false},{"id":"b1","kind":"paragraph","spans":[{"t":"The Clinician-Rated Dimensions of Psychosis Symptom Severity is an 8-item measure that","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"may be completed by the clinician at the time of the clinical assessment. Each item asks the","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"clinician to rate the severity of each symptom as experienced by the individual when it was at its","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"most severe during the past 7 days.","id":14,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,232.65,540.0,287.85],"firstLineX":90.0,"indent":0,"small":false},{"id":"b2","kind":"heading","spans":[{"t":"Scoring and Interpretation","id":15,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,303.69,244.39,317.49],"firstLineX":72.0,"indent":0,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"Each item on the measure is rated on a 5-point scale (0 = none; 1 = equivocal; 2 = present, but","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"mild; 3 = present and moderate; and 4 = present and severe) with a symptom-specific definition","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"of each rating level. The clinician reviews all of the individual’s available information and, based","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"on clinical judgment, selects (with checkmark) the level that most accurately describes the","id":19,"b":false,"i":false,"s":false},{"t":" "},{"t":"severity of the symptom domain. The clinician then indicates the score for each item in the","id":20,"b":false,"i":false,"s":false},{"t":" "},{"t":"“Score” column provided.","id":21,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,323.85,539.89,407.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b4","kind":"heading","spans":[{"t":"Frequency of Use","id":22,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,423.69,187.73,437.49],"firstLineX":72.0,"indent":0,"small":false},{"id":"b5","kind":"paragraph","spans":[{"t":"To track changes in the individual’s symptom severity over time, the measure may be completed","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"at regular intervals as clinically indicated, depending on the stability of the individual’s","id":24,"b":false,"i":false,"s":false},{"t":" "},{"t":"symptoms and treatment status. Consistently high scores on a particular domain may indicate","id":25,"b":false,"i":false,"s":false},{"t":" "},{"t":"significant and problematic areas for the individual that might warrant further assessment,","id":26,"b":false,"i":false,"s":false},{"t":" "},{"t":"treatment, and follow-up. Clinical judgment should always guide decision making.","id":27,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,444.45,539.89,514.05],"firstLineX":72.0,"indent":0,"small":false},{"id":"b6","kind":"marker","spans":[{"t":"852","id":28,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,528.45,315.0,540.45],"firstLineX":297.0,"indent":60,"small":false},{"id":"b7","kind":"heading","spans":[{"t":"Clinician-Rated Dimensions of Psychosis Symptom Severity","id":29,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,555.69,467.41,569.49],"firstLineX":72.0,"indent":0,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"Name:________________________________","id":30,"b":true,"i":false,"s":false},{"t":"______","id":31,"b":false,"i":false,"s":false},{"t":" "},{"t":"Age: __________","id":32,"b":true,"i":false,"s":false},{"t":" "},{"t":"Date:________________","id":33,"b":true,"i":false,"s":false}],"level":4,"bbox":[73.2,586.84,526.77,595.88],"firstLineX":73.2,"indent":1,"small":true},{"id":"b9","kind":"paragraph","spans":[{"t":"Instructions:","id":34,"b":true,"i":false,"s":false},{"t":" Based on all the information you have on the individual and using your clinical judgment, please rate (with","id":35,"b":false,"i":false,"s":false}],"level":4,"bbox":[73.2,601.84,510.06,610.88],"firstLineX":73.2,"indent":1,"small":true},{"id":"b10","kind":"paragraph","spans":[{"t":"checkmark) the presence and severity of the following symptoms as experienced by the individual, when each symptom was","id":36,"b":false,"i":false,"s":false},{"t":" "},{"t":"at its most severe, in the past seven (7) days.","id":37,"b":false,"i":false,"s":false},{"t":" "},{"t":"Domain","id":38,"b":false,"i":false,"s":false},{"t":" "},{"t":"0","id":39,"b":false,"i":false,"s":false},{"t":" "},{"t":"1","id":40,"b":false,"i":false,"s":false},{"t":" "},{"t":"2","id":41,"b":false,"i":false,"s":false},{"t":" "},{"t":"3","id":42,"b":false,"i":false,"s":false},{"t":" "},{"t":"4","id":43,"b":false,"i":false,"s":false},{"t":" "},{"t":"Score","id":44,"b":false,"i":false,"s":false}],"level":4,"bbox":[75.6,612.34,540.09,644.01],"firstLineX":82.2,"indent":4,"small":true},{"id":"b11","kind":"paragraph","spans":[{"t":"I. Hallucinations","id":45,"b":false,"i":false,"s":false},{"t":" ","id":46,"b":false,"i":false,"s":false},{"t":"❑","id":47,"b":false,"i":false,"s":false},{"t":" Not","id":48,"b":false,"i":false,"s":false},{"t":" "},{"t":"❑","id":50,"b":false,"i":false,"s":false},{"t":" Equivocal (severity or","id":51,"b":false,"i":false,"s":false},{"t":" "},{"t":"❑","id":54,"b":false,"i":false,"s":false},{"t":" Present, but","id":55,"b":false,"i":false,"s":false},{"t":" "},{"t":"❑","id":62,"b":false,"i":false,"s":false},{"t":" Present and","id":63,"b":false,"i":false,"s":false},{"t":" "},{"t":"❑","id":70,"b":false,"i":false,"s":false},{"t":" Present and","id":71,"b":false,"i":false,"s":false}],"level":4,"bbox":[73.8,649.87,487.36,659.74],"firstLineX":73.8,"indent":2,"small":true},{"id":"b12","kind":"paragraph","spans":[{"t":"present","id":49,"b":false,"i":false,"s":false},{"t":" "},{"t":"duration not sufficient to be","id":52,"b":false,"i":false,"s":false},{"t":" "},{"t":"considered psychosis)","id":53,"b":false,"i":false,"s":false}],"level":4,"bbox":[147.6,660.34,285.9,678.94],"firstLineX":147.6,"indent":60,"small":true},{"id":"b16","kind":"paragraph","spans":[{"t":"mild (little","id":56,"b":false,"i":false,"s":false},{"t":" "},{"t":"pressure to act","id":57,"b":false,"i":false,"s":false},{"t":" "},{"t":"upon voices or","id":58,"b":false,"i":fals