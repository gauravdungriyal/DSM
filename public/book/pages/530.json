"kind":"paragraph","spans":[{"t":"Acute episode:","id":21,"b":true,"i":false,"s":false},{"t":" Symptoms present for less than 6 months.","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"Persistent:","id":23,"b":true,"i":false,"s":false},{"t":" Symptoms occurring for 6 months or more.","id":24,"b":false,"i":false,"s":false}],"level":4,"bbox":[97.2,328.49,411.01,358.49],"firstLineX":97.2,"indent":25,"small":false},{"id":"b3","kind":"marker","spans":[{"t":"361","id":25,"b":false,"i":false,"s":false}],"level":4,"bbox":[294.0,374.25,312.0,386.25],"firstLineX":294.0,"indent":60,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"Specify","id":26,"b":false,"i":true,"s":false},{"t":" if:","id":27,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,400.47,129.97,412.49],"firstLineX":78.0,"indent":6,"small":false},{"id":"b5","kind":"paragraph","spans":[{"t":"With psychological stressor","id":28,"b":true,"i":false,"s":false},{"t":" ","id":29,"b":false,"i":false,"s":false},{"t":"(specify stressor)","id":30,"b":false,"i":true,"s":false},{"t":" "},{"t":"Without psychological stressor","id":31,"b":true,"i":false,"s":false}],"level":4,"bbox":[97.2,417.27,351.67,447.29],"firstLineX":97.2,"indent":25,"small":false},{"id":"b6","kind":"heading","spans":[{"t":"Diagnostic Features","id":32,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,472.29,203.82,486.09],"firstLineX":72.0,"indent":0,"small":false},{"id":"b7","kind":"paragraph","spans":[{"t":"In functional neurological symptom disorder (conversion disorder), there may be one or more","id":33,"b":false,"i":false,"s":false},{"t":" "},{"t":"neurological symptoms of various types. Motor symptoms include weakness or paralysis;","id":34,"b":false,"i":false,"s":false},{"t":" "},{"t":"abnormal movements, such as tremor, jerks, or dystonic movements; and gait abnormalities.","id":35,"b":false,"i":false,"s":false},{"t":" "},{"t":"Sensory symptoms include altered, reduced, or absent skin sensation, vision, or hearing.","id":36,"b":false,"i":false,"s":false},{"t":" "},{"t":"Episodes of apparent unresponsiveness with or without limb movements may resemble epileptic","id":37,"b":false,"i":false,"s":false},{"t":" "},{"t":"seizures, syncope, or coma (also called ","id":38,"b":false,"i":false,"s":false},{"t":"dissociative","id":39,"b":false,"i":true,"s":false},{"t":", ","id":40,"b":false,"i":false,"s":false},{"t":"psychogenic","id":41,"b":false,"i":true,"s":false},{"t":", or ","id":42,"b":false,"i":false,"s":false},{"t":"nonepileptic seizures or","id":43,"b":false,"i":true,"s":false},{"t":" "},{"t":"attacks","id":44,"b":false,"i":true,"s":false},{"t":"). Other symptoms include reduced or absent speech volume (dysphonia/aphonia); altered","id":45,"b":false,"i":false,"s":false},{"t":" "},{"t":"speech articulation, prosody, or fluency; a sensation of a lump in the throat (globus); and","id":46,"b":false,"i":false,"s":false},{"t":" "},{"t":"diplopia. This disorder has been called “conversion disorder” in prior editions of DSM as well as","id":47,"b":false,"i":false,"s":false},{"t":" "},{"t":"in much of the psychiatric research literature. The term “conversion” originated in","id":48,"b":false,"i":false,"s":false},{"t":" "},{"t":"psychoanalytic theory, which proposes that unconscious psychic conflict is “converted” into","id":49,"b":false,"i":false,"s":false},{"t":" "},{"t":"physical symptoms.","id":50,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,492.45,539.98,662.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"The diagnosis rests on clinical findings that show clear evidence of incompatibility with","id":51,"b":false,"i":false,"s":false},{"t":" "},{"t":"recognized neurological disease. These should usually be elicited and interpreted in the context","id":52,"b":false,"i":false,"s":false},{"t":" "},{"t":"of the whole clinical picture by a health care professional with expertise in the diagnosis of","id":53,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,665.25,539.97,706.05],"firstLineX":90.0,"indent":0,"small":false}],"figures":[],"ocr":null,"nativeTextSha256":"21a5dfd6c973308a3da701e6a4f0f9b55049263e6df78b71d3aece7facfd2259","nativeCharacters":2113,"sparse":false,"tableCount":0}