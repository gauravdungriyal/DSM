{"number":843,"file":8,"localPage":35,"markers":[],"blocks":[{"id":"b1","kind":"paragraph","spans":[{"t":"naloxone can support the diagnosis of opioid intoxication, nonresponse may be due to the co-","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"ingestion of an opioid with another drug (e.g., a benzodiazepine, alcohol) or to ingestion of a","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"higher dose of and/or higher-potency opioid (e.g., fentanyl).","id":3,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,74.25,539.91,115.05],"firstLineX":72.0,"indent":0,"small":false},{"id":"b0","kind":"paragraph","spans":[{"t":"Opioid-induced mental disorders.","id":0,"b":true,"i":false,"s":false},{"t":" "},{"t":"Opioid intoxication is distinguished from opioid-induced mental","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorders (e.g., opioid-induced depressive disorder, with onset during intoxication) because the","id":5,"b":false,"i":false,"s":false},{"t":" "},{"t":"symptoms (e.g., depressed mood) in the latter disorders are in excess of those usually associated","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"with opioid intoxication, predominate in the clinical presentation, and are severe enough to","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"warrant clinical attention.","id":8,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,120.21,539.99,190.65],"firstLineX":72.0,"indent":0,"small":false},{"id":"b3","kind":"heading","spans":[{"t":"Comorbidity","id":9,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,206.49,153.22,220.29],"firstLineX":72.0,"indent":0,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"Given the typical overlap of opioid intoxication with opioid use disorder, see “Comorbidity”","id":10,"b":false,"i":false,"s":false},{"t":" "},{"t":"under Opioid Use Disorder for more details about co-occurring conditions that are likely to be","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"encountered.","id":12,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,226.65,539.91,267.45],"firstLineX":72.0,"indent":0,"small":false},{"id":"b5","kind":"heading","spans":[{"t":"Opioid Withdrawal","id":13,"b":true,"i":false,"s":false}],"level":3,"bbox":[389.05,291.16,536.41,307.96],"firstLineX":389.05,"indent":60,"small":false},{"id":"b6","kind":"heading","spans":[{"t":"Diagnostic Criteria","id":14,"b":true,"i":false,"s":false}],"level":4,"bbox":[78.6,333.69,201.2,347.49],"firstLineX":78.6,"indent":7,"small":false},{"id":"b7","kind":"paragraph","spans":[{"t":"A. Presence of either of the following:","id":15,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,368.09,282.3,380.09],"firstLineX":78.0,"indent":6,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"1. Cessation of (or reduction in) opioid use that has been heavy and prolonged","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"(i.e., several weeks or longer).","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"2. Administration of an opioid antagonist after a period of opioid use.","id":18,"b":false,"i":false,"s":false}],"level":4,"bbox":[96.0,387.29,527.95,430.49],"firstLineX":96.0,"indent":24,"small":false},{"id":"b9","kind":"paragraph","spans":[{"t":"B. Three (or more) of the following developing within minutes to several days after","id":19,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,437.69,527.68,449.69],"firstLineX":78.0,"indent":6,"small":false},{"id":"b10","kind":"paragraph","spans":[{"t":"Criterion A:","id":20,"b":false,"i":false,"s":false}],"level":4,"bbox":[98.4,452.09,158.36,464.09],"firstLineX":98.4,"indent":26,"small":false},{"id":"b11","kind":"paragraph","spans":[{"t":"1. Dysphoric mood.","id":21,"b":false,"i":false,"s":false},{"t":" "},{"t":"2. Nausea or vomiting.","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"3. Muscle aches.","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"4. Lacrimation or rhinorrhea.","id":24,"b":false,"i":false,"s":false},{"t":" "},{"t":"5. Pupillary dilation, piloerection, or sweating.","id":25,"b":false,"i":false,"s":false},{"t":" "},{"t":"6. Diarrhea.","id":26,"b":false,"i":false,"s":false},{"t":" "},{"t":"7. Yawning.","id":27,"b":false,"i":false,"s":false},{"t":" "},{"t":"8. Fever.","id":28,"b":false,"i":false,"s":false},{"t":" "},{"t":"9. Insomnia.","id":29,"b":false,"i":false,"s":false}],"level":4,"bbox":[96.0,471.29,341.74,617.69],"firstLineX":96.0,"indent":24,"small":false},{"id":"b12","kind":"paragraph","spans":[{"t":"C. The signs or symptoms in Criterion B cause clinically significant distress or","id":30,"b":false,"i":false,"s":false}],"level":4,"bbox":[76.8,624.89,527.71,636.89],"firstLineX":76.8,"indent":5,"small":false},{"id":"b13","kind":"paragraph","spans":[{"t":"impairment in social, occupational, or other important areas of functioning.","id":31,"b":false,"i":false,"s":false},{"t":" "},{"t":"D. The signs or symptoms are not attributable to another medical condition and are","id":32,"b":false,"i":false,"s":false}],"level":4,"bbox":[76.8,639.29,527.64,668.09],"firstLineX":98.4,"indent":5,"small":false},{"id":"b14","kind":"paragraph","spans":[{"t":"not better explained by another mental disorder, including intoxication or","id":33,"b":false,"i":false,"s":false},{"t":" "},{"t":"withdrawal from another substance.","id":34,"b":false,"i":false,"s":false},{"t":" "},{"t":"Coding note:","id":35,"b":true,"i":false,"s":false},{"t":" The ICD-10-CM code depends on whether or not there is a comorbid","id":36,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,670.49,527.67,713.69],"firstLineX":98.4,"indent":6,"small":false}],"figures":[],"ocr":null,"nativeTextSha256":"e9ab96874df31a5732a223d466bbaaf9cd2d0dbaa0cddf944de910984392921d","nativeCharacters":1852,"sparse":false,"tableCount":0}