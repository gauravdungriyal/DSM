{"number":311,"file":3,"localPage":9,"markers":["185"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"In full remission (p. 214)","id":0,"b":false,"i":false,"s":false},{"t":" "},{"t":"F32.5","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"F33.42","id":2,"b":false,"i":false,"s":false}],"level":4,"bbox":[81.0,74.01,490.4,83.01],"firstLineX":81.0,"indent":9,"small":true},{"id":"b1","kind":"paragraph","spans":[{"t":"Unspecified","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"F32.9","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"F33.9","id":5,"b":false,"i":false,"s":false}],"level":4,"bbox":[81.0,87.81,487.89,96.81],"firstLineX":81.0,"indent":9,"small":true},{"id":"b2","kind":"paragraph","spans":[{"t":"*","id":6,"b":false,"i":false,"s":false},{"t":"For an episode to be considered recurrent, there must be an interval of at least 2 consecutive months between","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"separate episodes in which criteria are not met for a major depressive episode. The definitions of specifiers are","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"found on the indicated pages.","id":9,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,122.01,527.85,152.61],"firstLineX":78.0,"indent":6,"small":true},{"id":"b3","kind":"paragraph","spans":[{"t":"**","id":10,"b":false,"i":false,"s":false},{"t":"If psychotic features are present, code the “with psychotic features” specifier irrespective of episode severity.","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"In recording the name of a diagnosis, terms should be listed in the following order:","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"major depressive disorder, single or recurrent episode, severity/psychotic/remission","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"specifiers, followed by as many of the following specifiers without codes that apply to","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"the current episode (or the most recent episode if the major depressive disorder is in","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"partial or full remission). ","id":16,"b":false,"i":false,"s":false},{"t":"Note:","id":17,"b":true,"i":false,"s":false},{"t":" The specifier “with seasonal pattern” describes the","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"pattern of recurrent major depressive episodes.","id":19,"b":false,"i":false,"s":false},{"t":" "},{"t":"Specify","id":20,"b":false,"i":true,"s":false},{"t":" if:","id":21,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,159.21,527.79,273.29],"firstLineX":78.0,"indent":6,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"With anxious distress","id":22,"b":true,"i":false,"s":false},{"t":" (pp. 210–211)","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"With mixed features","id":24,"b":true,"i":false,"s":false},{"t":" (p. 211)","id":25,"b":false,"i":false,"s":false},{"t":" "},{"t":"With melancholic features","id":26,"b":true,"i":false,"s":false},{"t":" (pp. 211–212)","id":27,"b":false,"i":false,"s":false}],"level":4,"bbox":[97.2,278.09,323.71,326.09],"firstLineX":97.2,"indent":25,"small":false},{"id":"b5","kind":"marker","spans":[{"t":"185","id":28,"b":false,"i":false,"s":false}],"level":4,"bbox":[300.0,341.85,318.0,353.85],"firstLineX":300.0,"indent":60,"small":false},{"id":"b6","kind":"paragraph","spans":[{"t":"With atypical features","id":29,"b":true,"i":false,"s":false},{"t":" (p. 212)","id":30,"b":false,"i":false,"s":false},{"t":" "},{"t":"With mood-congruent psychotic features","id":31,"b":true,"i":false,"s":false},{"t":" (p. 213)","id":32,"b":false,"i":false,"s":false},{"t":" "},{"t":"With mood-incongruent psychotic features","id":33,"b":true,"i":false,"s":false},{"t":" (p. 213)","id":34,"b":false,"i":false,"s":false},{"t":" "},{"t":"With catatonia","id":35,"b":true,"i":false,"s":false},{"t":" (p. 213). ","id":36,"b":false,"i":false,"s":false},{"t":"Coding note:","id":37,"b":true,"i":false,"s":false},{"t":" Use additional code F06.1.","id":38,"b":false,"i":false,"s":false},{"t":" "},{"t":"With peripartum onset","id":39,"b":true,"i":false,"s":false},{"t":" (p. 213)","id":40,"b":false,"i":false,"s":false},{"t":" "},{"t":"With seasonal pattern","id":41,"b":true,"i":false,"s":false},{"t":" (applies to pattern of recurrent major depressive","id":42,"b":false,"i":false,"s":false},{"t":" "},{"t":"episodes) (p. 214)","id":43,"b":false,"i":false,"s":false}],"level":4,"bbox":[97.2,369.29,526.48,485.69],"firstLineX":97.2,"indent":25,"small":false},{"id":"b7","kind":"heading","spans":[{"t":"Diagnostic Features","id":44,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,510.69,203.82,524.49],"firstLineX":72.0,"indent":0,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"Major depressive disorder is defined by the presence of at least one major depressive episode","id":45,"b":false,"i":false,"s":false},{"t":" "},{"t":"occurring in the absence of a history of manic or hypomanic episodes. The essential feature of a","id":46,"b":false,"i":false,"s":false},{"t":" "},{"t":"major depressive episode is a period lasting at least 2 weeks during which there is either","id":47,"b":false,"i":false,"s":false},{"t":" "},{"t":"depressed mood or the loss of interest or pleasure in all or nearly all activities for most of the day","id":48,"b":false,"i":false,"s":false},{"t":" "},{"t":"nearly every day (Criterion A). The individual must also experience at least four additional","id":49,"b":false,"i":false,"s":false},{"t":" "},{"t":"symptoms during the same 2-week period, drawn from a list that includes changes in appetite or","id":50,"b":false,"i":false,"s":false},{"t":" "},{"t":"weight, sleep, and psychomotor activity; decreased energy; feelings of worthlessness or guilt;","id":51,"b":false,"i":false,"s":false},{"t":" "},{"t":"difficulty thinking, concentrating, or making decisions; or thoughts of death, suicidal ideation, a","id":52,"b":false,"i":false,"s":false},{"t":" "},{"t":"suicide attempt, or a specific plan for suicidal behavior. To count toward a diagnosis of a major","id":53,"b":false,"i":false,"s":false},{"t":" "},{"t":"depressive episode, a symptom must either be newly present or have clearly worsened compared","id":54,"b":false,"i":false,"s":false},{"t":" "},{"t":"with the individual’s pre-episode status. Moreover, the symptoms must occur nearly every day,","id":55,"b":false,"i":false,"s":false},{"t":" "},{"t":"for at least 2 consecutive weeks, with the exception of thoughts of death and suicidal ideation,","id":56,"b":false,"i":false,"s":false},{"t":" "},{"t":"which must be recurrent, and attempting suicide or making a specific plan, which only needs to","id":57,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,530.85,539.92,715.65],"firstLineX":72.0,"indent":0,"small":false}],"figures":[],"ocr":null,"nativeTextSha256":"4a2880488b0a06a73be2e27803839064f6df6cee5a9812ac4b7a3e9fefcfcc50","nativeCharacters":2617,"sparse":false,"tableCount":0}