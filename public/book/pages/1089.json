 clinical attention. Child neglect is","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"defined as any confirmed or suspected egregious act or omission by a child’s parent or other","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"caregiver that deprives the child of basic age-appropriate needs and thereby results, or has","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"reasonable potential to result, in physical or psychological harm to the child. Child neglect","id":19,"b":false,"i":false,"s":false},{"t":" "},{"t":"encompasses abandonment; lack of appropriate supervision; failure to attend to necessary","id":20,"b":false,"i":false,"s":false},{"t":" "},{"t":"emotional or psychological needs; and failure to provide necessary education, medical care,","id":21,"b":false,"i":false,"s":false},{"t":" "},{"t":"nourishment, shelter, and/or clothing.","id":22,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,186.89,539.93,299.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b6","kind":"paragraph","spans":[{"t":"Child Neglect, Confirmed","id":23,"b":true,"i":false,"s":false},{"t":" "},{"t":"T74.02XA","id":24,"b":true,"i":false,"s":false},{"t":" ","id":25,"b":false,"i":false,"s":false},{"t":"Initial encounter","id":26,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,314.3,210.93,344.25],"firstLineX":72.0,"indent":0,"small":false},{"id":"b7","kind":"paragraph","spans":[{"t":"T74.02XD","id":27,"b":true,"i":false,"s":false},{"t":" ","id":28,"b":false,"i":false,"s":false},{"t":"Subsequent encounter","id":29,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,352.49,237.61,364.65],"firstLineX":72.0,"indent":0,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"Child Neglect, Suspected","id":30,"b":true,"i":false,"s":false},{"t":" "},{"t":"T76.02XA","id":31,"b":true,"i":false,"s":false},{"t":" ","id":32,"b":false,"i":false,"s":false},{"t":"Initial encounter","id":33,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,381.5,210.93,41