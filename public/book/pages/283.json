{"number":283,"file":2,"localPage":82,"markers":["163"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"clinical attention.","id":0,"b":false,"i":false,"s":false},{"t":" "},{"t":"Coding note:","id":1,"b":true,"i":false,"s":false},{"t":" The ICD-10-CM codes for the [specific substance/medication]-induced","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"bipolar and related disorders are indicated in the table below. Note that the ICD-10-","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"CM code depends on whether or not there is a comorbid substance use disorder","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"present for the same class of substance. In any case, an additional separate","id":5,"b":false,"i":false,"s":false},{"t":" "},{"t":"diagnosis of a substance use disorder is not given. If a mild substance use disorder","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"is comorbid with the substance-induced bipolar and related disorder, the 4th position","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"character is “1,” and the clinician should record “mild [substance] use disorder”","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"before the substance-induced bipolar and related disorder (e.g., “mild cocaine use","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder with cocaine-induced bipolar and related disorder”). If a moderate or severe","id":10,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance use disorder is comorbid with the substance-induced bipolar and related","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder, the 4th position character is “2,” and the clinician should record “moderate","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"[substance] use disorder” or “severe [substance] use disorder,” depending on the","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"severity of the comorbid substance use disorder. If there is no comorbid substance","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"use disorder (e.g., after a one-time heavy use of the substance), then the 4th","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"position character is “9,” and the clinician should record only the substance-induced","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"bipolar and related disorder.","id":17,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,73.85,528.01,318.89],"firstLineX":78.0,"indent":6,"small":false},{"id":"b1","kind":"marker","spans":[{"t":"163","id":18,"b":false,"i":false,"s":false}],"level":4,"bbox":[294.0,333.45,312.0,345.45],"firstLineX":294.0,"indent":60,"small":false},{"id":"b2","kind":"paragraph","spans":[{"t":"ICD-10-CM","id":19,"b":true,"i":false,"s":false}],"level":4,"bbox":[365.68,364.49,426.31,376.49],"firstLineX":365.68,"indent":60,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"With mild use","id":20,"b":true,"i":false,"s":false},{"t":" "},{"t":"With moderate or","id":22,"b":true,"i":false,"s":false},{"t":" "},{"t":"severe use disorder","id":23,"b":true,"i":false,"s":false}],"level":4,"bbox":[275.29,389.31,436.96,409.11],"firstLineX":275.29,"indent":60,"small":true},{"id":"b6","kind":"paragraph","spans":[{"t":"Without use","id":24,"b":true,"i":false,"s":false}],"level":4,"bbox":[458.78,389.31,510.22,398.31],"firstLineX":458.78,"indent":60,"small":true},{"id":"b4","kind":"paragraph","spans":[{"t":"disorder","id":21,"b":true,"i":false,"s":false},{"t":" "},{"t":"disorder","id":25,"b":true,"i":false,"s":false}],"level":4,"bbox":[286.52,400.11,502.48,409.11],"firstLineX":286.52,"indent":60,"small":true},{"id":"b8","kind":"paragraph","spans":[{"t":"Alcohol","id":26,"b":false,"i":false,"s":false},{"t":" "},{"t":"F10.14","id":27,"b":false,"i":false,"s":false},{"t":" "},{"t":"F10.24","id":28,"b":false,"i":false,"s":false},{"t":" "},{"t":"F10.94","id":29,"b":false,"i":false,"s":false}],"level":4,"bbox":[81.0,416.01,501.5,425.01],"firstLineX":81.0,"indent":9,"small":true},{"id":"b9","kind":"p