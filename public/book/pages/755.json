{"number":755,"file":7,"localPage":48,"markers":["544","545"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"disorders (diagnostic criteria and text are provided in this manual for substance/medication-","id":0,"b":false,"i":false,"s":false},{"t":" "},{"t":"induced psychotic disorders, bipolar and related disorders, depressive disorders, anxiety","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorders, obsessive-compulsive and related disorders, sleep disorders, sexual dysfunctions,","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"delirium, and neurocognitive disorders in their respective chapters). The term","id":3,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,74.47,539.97,129.45],"firstLineX":72.0,"indent":0,"small":false},{"id":"b1","kind":"marker","spans":[{"t":"544","id":4,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,143.85,315.0,155.85],"firstLineX":297.0,"indent":60,"small":false},{"id":"b2","kind":"paragraph","spans":[{"t":"substance/medication-induced mental disorder","id":5,"b":false,"i":true,"s":false},{"t":" refers to symptomatic presentations that are","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"due to the physiological effects of an exogenous substance on the central nervous system and","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"includes typical intoxicants (e.g., alcohol, inhalants, cocaine), psychotropic medications (e.g.,","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"stimulants, sedative-hypnotics), other medications, (e.g., steroids), and environmental toxins","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"(e.g., organophosphate insecticides).","id":10,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,170.25,540.0,239.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"The current section begins with a general discussion of criteria sets for substance use","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder, substance intoxication, substance withdrawal, and substance/medication-induced","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"mental disorders, at least some of which are applicable across classes of substances. Reflecting","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"some unique aspects of the 10 substance classes relevant to this chapter, the remainder of the","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"chapter is organized by substance class. To facilitate differential diagnosis, the diagnostic criteria","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"and text for the substance/medication-induced mental disorders are included with disorders with","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"which they share phenomenology (e.g., substance/medication-induced depressive disorder is in","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"the chapter “Depressive Disorders”). Note that only certain classes of drugs are capable of","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"causing particular types of substance-induced disorders. The substance-related diagnostic","id":19,"b":false,"i":false,"s":false},{"t":" "},{"t":"categories associated with specific drug classes are shown in Table 1.","id":20,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,242.25,539.99,383.85],"firstLineX":90.0,"indent":0,"small":false},{"id":"b4","kind":"marker","spans":[{"t":"545","id":21,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,398.25,315.0,410.25],"firstLineX":297.0,"indent":60,"small":false},{"id":"b5","kind":"paragraph","spans":[{"t":"TABLE 1","id":22,"b":true,"i":false,"s":false},{"t":" Diagnoses associated with substance class","id":23,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,428.69,380.43,440.69],"firstLineX":72.0,"indent":0,"small":false},{"id":"b8","kind":"paragraph","spans":[{"t":"Bipolar","id":26,"b":true,"i":false,"s":false},{"t":" "},{"t":"Obsessive-","id":34,"b":true,"i":false,"s":false},{"t":