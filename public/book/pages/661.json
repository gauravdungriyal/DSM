{"number":661,"file":6,"localPage":55,"markers":["469"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"Coding note:","id":0,"b":true,"i":false,"s":false},{"t":" The ICD-10-CM codes for the [specific substance/medication]-induced","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"sleep disorders are indicated in the table below. Note that the ICD-10-CM code","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"depends on whether or not there is a comorbid substance use disorder present for","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"the same class of substance. In any case, an additional separate diagnosis of a","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance use disorder is not given. If a mild substance use disorder is comorbid","id":5,"b":false,"i":false,"s":false},{"t":" "},{"t":"with the substance-induced sleep disorder, the 4th position character is “1,” and the","id":6,"b":false,"i":false,"s":false},{"t":" "},{"t":"clinician should record “mild [substance] use disorder” before the substance-induced","id":7,"b":false,"i":false,"s":false},{"t":" "},{"t":"sleep disorder (e.g., “mild cocaine use disorder with cocaine-induced sleep","id":8,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder”). If a moderate or severe substance use disorder is comorbid with the","id":9,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance-induced sleep disorder, the 4th position character is “2,” and the clinician","id":10,"b":false,"i":false,"s":false},{"t":" "},{"t":"should record “moderate [substance] use disorder” or “severe [substance] use","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"disorder,” depending on the severity of the comorbid substance use disorder. If there","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"is no comorbid substance use disorder (e.g., after a one-time heavy use of the","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"substance), then the 4th position character is “9,” and the clinician should record","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"only the substance-induced sleep disorder.","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"There are two exceptions to this coding convention as it applies to caffeine- and","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"tobacco-induced sleep disorders. Because caffeine use disorder is not an official","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"DSM-5 category,","id":18,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,74.09,527.95,333.29],"firstLineX":78.0,"indent":6,"small":false},{"id":"b1","kind":"marker","spans":[{"t":"469","id":19,"b":false,"i":false,"s":false}],"level":4,"bbox":[294.0,347.85,312.0,359.85],"firstLineX":294.0,"indent":60,"small":false},{"id":"b2","kind":"paragraph","spans":[{"t":"there is only a single ICD-10-CM code for caffeine-induced sleep disorder: F15.982.","id":20,"b":false,"i":false,"s":false},{"t":" "},{"t":"Moreover, because ICD-10-CM assumes that tobacco-induced sleep disorder can","id":21,"b":false,"i":false,"s":false},{"t":" "},{"t":"only occur in the context of moderate or severe tobacco use disorder, the ICD-10-","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"CM code for tobacco-induced sleep disorder is F17.208.","id":23,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,374.09,527.91,429.29],"firstLineX":78.0,"indent":6,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"ICD-10-CM","id":24,"b":true,"i":false,"s":false}],"level":4,"bbox":[365.68,448.49,426.31,460.49],"firstLineX":365.68,"indent":60,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"With mild use","id":25,"b":true,"i":false,"s":false},{"t":" "},{"t":"With moderate or","id":27,"b":true,"i":false,"s":false},{"t":" "},{"t":"severe use disorder","id":28,"b":true,"i":false,"s":false}],"level":4,"bbox":[275.29,473.31,436.96,493.11],"firstLineX":275.29,"indent":60,"small":true},{"id":"b7","kind":"paragraph","spans":[{"t":"Without use","i