{"number":1063,"file":10,"localPage":53,"markers":["802"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"Examples of presentations that can be specified using the “other specified” designation","id":0,"b":false,"i":false,"s":false},{"t":" "},{"t":"include, but are not limited to, recurrent and intense sexual arousal involving ","id":1,"b":false,"i":false,"s":false},{"t":"telephone","id":2,"b":false,"i":true,"s":false},{"t":" "},{"t":"scatologia","id":3,"b":false,"i":true,"s":false},{"t":" (obscene phone calls), ","id":4,"b":false,"i":false,"s":false},{"t":"necrophilia","id":5,"b":false,"i":true,"s":false},{"t":" (corpses), ","id":6,"b":false,"i":false,"s":false},{"t":"zoophilia","id":7,"b":false,"i":true,"s":false},{"t":" (animals), ","id":8,"b":false,"i":false,"s":false},{"t":"coprophilia","id":9,"b":false,"i":true,"s":false},{"t":" "},{"t":"(feces), ","id":10,"b":false,"i":false,"s":false},{"t":"klismaphilia","id":11,"b":false,"i":true,"s":false},{"t":" (enemas), or ","id":12,"b":false,"i":false,"s":false},{"t":"urophilia","id":13,"b":false,"i":true,"s":false},{"t":" (urine) that has been present for at least 6 months","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"and causes marked distress or impairment in social, occupational, or other important areas of","id":15,"b":false,"i":false,"s":false},{"t":" "},{"t":"functioning. Other specified paraphilic disorder can be specified as in remission and/or as","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"occurring in a controlled environment.","id":17,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,74.25,527.84,172.65],"firstLineX":96.0,"indent":6,"small":false},{"id":"b1","kind":"heading","spans":[{"t":"Unspecified Paraphilic Disorder","id":18,"b":true,"i":false,"s":false}],"level":3,"bbox":[282.64,202.36,536.4,219.16],"firstLineX":282.64,"indent":60,"small":false},{"id":"b2","kind":"heading","spans":[{"t":"F65.9","id":19,"b":true,"i":false,"s":false}],"level":4,"bbox":[497.54,235.89,532.8,249.69],"firstLineX":497.54,"indent":60,"small":false},{"id":"b3","kind":"paragraph","spans":[{"t":"This category applies to presentations in which symptoms characteristic of a","id":20,"b":false,"i":false,"s":false},{"t":" "},{"t":"paraphilic disorder that cause clinically significant distress or impairment in social,","id":21,"b":false,"i":false,"s":false},{"t":" "},{"t":"occupational, or other important areas of functioning predominate but do not meet","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"the full criteria for any of the disorders in the paraphilic disorders diagnostic class.","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"The unspecified paraphilic disorder category is used in situations in which the","id":24,"b":false,"i":false,"s":false},{"t":" "},{"t":"clinician chooses ","id":25,"b":false,"i":false,"s":false},{"t":"not","id":26,"b":false,"i":true,"s":false},{"t":" to specify the reason that the criteria are not met for a specific","id":27,"b":false,"i":false,"s":false},{"t":" "},{"t":"paraphilic disorder, and includes presentations in which there is insufficient","id":28,"b":false,"i":false,"s":false},{"t":" "},{"t":"information to make a more specific diagnosis.","id":29,"b":false,"i":false,"s":false}],"level":4,"bbox":[78.0,267.89,528.0,380.69],"firstLineX":78.0,"indent":6,"small":false},{"id":"b4","kind":"marker","spans":[{"t":"802","id":30,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,401.85,315.0,413.85],"firstLineX":297.0,"indent":60,"small":false}],"figures":[],"ocr":null,"nativeTextSha256":"96cb787f1c9386a931edadbcc0bff261e1b8f67832a081ce192b3f2c522ffd2d","nativeCharacters":1263,"sparse":false,"tableCount":0}