{"number":1110,"file":10,"localPage":100,"markers":["843","844"],"blocks":[{"id":"b0","kind":"paragraph","spans":[{"t":"rated and parent/guardian versions); the Clinician-Rated Dimensions of Psychosis Symptom","id":0,"b":false,"i":false,"s":false},{"t":" "},{"t":"Severity; and the WHODAS 2.0. Clinician instructions, scoring information, and interpretation","id":1,"b":false,"i":false,"s":false},{"t":" "},{"t":"guidelines are included for each. Description of the child-rated version is not included in print","id":2,"b":false,"i":false,"s":false},{"t":" "},{"t":"given the overall similarity in items, scoring, and clinician instructions and guidelines with the","id":3,"b":false,"i":false,"s":false},{"t":" "},{"t":"parent/guardian-rated version. These measures, including the child-rated version, and additional","id":4,"b":false,"i":false,"s":false},{"t":" "},{"t":"dimensional assessments, such as those for diagnostic severity, can be found online at","id":5,"b":false,"i":false,"s":false},{"t":" "},{"t":"www.psychiatry.org/dsm5","id":6,"b":false,"i":false,"s":false},{"t":".","id":7,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,74.25,539.94,172.65],"firstLineX":72.0,"indent":0,"small":false},{"id":"b1","kind":"marker","spans":[{"t":"843","id":8,"b":false,"i":false,"s":false}],"level":4,"bbox":[297.0,187.05,315.0,199.05],"firstLineX":297.0,"indent":60,"small":false},{"id":"b2","kind":"heading","spans":[{"t":"Cross-Cutting Symptom Measures","id":9,"b":false,"i":false,"s":false}],"level":3,"bbox":[72.0,218.56,328.59,235.36],"firstLineX":72.0,"indent":0,"small":false},{"id":"b3","kind":"heading","spans":[{"t":"Level 1 Cross-Cutting Symptom Measure","id":10,"b":true,"i":false,"s":false}],"level":4,"bbox":[72.0,251.49,340.98,265.29],"firstLineX":72.0,"indent":0,"small":false},{"id":"b4","kind":"paragraph","spans":[{"t":"The DSM-5 Level 1 Cross-Cutting Symptom Measure is a self- or informant-rated measure that","id":11,"b":false,"i":false,"s":false},{"t":" "},{"t":"assesses domains that are important across psychiatric diagnoses. It is intended to help clinicians","id":12,"b":false,"i":false,"s":false},{"t":" "},{"t":"identify additional areas of inquiry that may have significant impact on the individual’s treatment","id":13,"b":false,"i":false,"s":false},{"t":" "},{"t":"and prognosis. In addition, the measure may be used to track changes in the individual’s","id":14,"b":false,"i":false,"s":false},{"t":" "},{"t":"symptom presentation over time.","id":15,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,272.25,539.93,341.85],"firstLineX":72.0,"indent":0,"small":false},{"id":"b5","kind":"paragraph","spans":[{"t":"The adult version of the measure consists of 23 questions that assess 13 psychiatric domains,","id":16,"b":false,"i":false,"s":false},{"t":" "},{"t":"including depression, anger, mania, anxiety, somatic symptoms, suicidal ideation, psychosis,","id":17,"b":false,"i":false,"s":false},{"t":" "},{"t":"sleep problems, memory, repetitive thoughts and behaviors, dissociation, personality functioning,","id":18,"b":false,"i":false,"s":false},{"t":" "},{"t":"and substance use (","id":19,"b":false,"i":false,"s":false},{"t":"Table 1","id":20,"b":false,"i":false,"s":false},{"t":"). Each domain consists of one to three questions. Each item inquires","id":21,"b":false,"i":false,"s":false},{"t":" "},{"t":"about how much (or how often) the individual has been bothered by the specific symptom during","id":22,"b":false,"i":false,"s":false},{"t":" "},{"t":"the past 2 weeks. If the individual is of impaired capacity and unable to complete the form (e.g.,","id":23,"b":false,"i":false,"s":false},{"t":" "},{"t":"an individual with major neurocognitive disorder), a knowledgeable adult informant may","id":24,"b":false,"i":false,"s":false},{"t":" "},{"t":"complete this measure.","id":25,"b":false,"i":false,"s":false}],"level":4,"bbox":[72.0,344.25,539.9,457.05],"firstLineX":90.0,"indent":0,"small":false},{"id":"b6","kind":"marker","spans":[{"t":"